# The public Judge0 CE endpoint works for low-volume development.
# For production, point this at your managed Judge0 instance and set its key.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Keep these conservative unless you move to a paid provider plan.
DAILY_RUN_LIMIT=12
DAILY_SUBMIT_LIMIT=10

# Public Supabase values. The anon key is safe for browser use when RLS is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only this GitHub email can submit official exercise attempts.
OWNER_GITHUB_EMAIL=
